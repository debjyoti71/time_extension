{
  "name": "dev-timekeeper",
  "displayName": "Dev Timekeeper",
  "description": "Private, offline-first coding time tracker with real-time webview dashboard & PNG share card generator.",
  "version": "1.0.34",
  "license": "MIT",
  "keywords": [
    "time tracker",
    "coding metrics",
    "dashboard",
    "offline time tracker",
    "wakatime alternative",
    "developer productivity",
    "analytics",
    "active time"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/debjyoti71/time_extension/issues"
  },
  "homepage": "https://github.com/debjyoti71/time_extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/debjyoti71/time_extension.git"
  },
  "publisher": "DebjyotiGhosh",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timetracker.showDashboard",
        "title": "Show Dashboard",
        "category": "Time Tracker",
        "icon": "$(dashboard)"
      },
      {
        "command": "timetracker.shareCard",
        "title": "Generate Share Card",
        "category": "Time Tracker",
        "icon": "$(graph-line)"
      },
      {
        "command": "timetracker.reset",
        "title": "Reset All Data",
        "category": "Time Tracker",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "Dev Timekeeper",
      "properties": {
        "timetracker.idleTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "description": "System-wide idle timeout (in minutes) before pausing active time tracking."
        },
        "timetracker.inactivityHardLimitMinutes": {
          "type": "number",
          "default": 20,
          "description": "VS Code editor inactivity limit (in minutes) before pausing active session."
        },
        "timetracker.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the active coding time indicator in the status bar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "version:from-git": "node scripts/sync-version-from-git.mjs",
    "package:vsix": "npm run version:from-git && npm run compile && npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "chartjs-chart-treemap": "^3.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.0.0"
  }
}
