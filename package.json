{
  "name": "dev-timekeeper",
  "displayName": "Dev Timekeeper",
  "description": "Track coding time per file and directory, locally",
  "version": "1.0.33",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debjyoti71/time_extension.git"
  },
  "publisher": "DebjyotiGhosh",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timetracker.showDashboard",
        "title": "Time Tracker: Show Dashboard"
      },
      {
        "command": "timetracker.shareCard",
        "title": "Time Tracker: Generate Share Card"
      },
      {
        "command": "timetracker.reset",
        "title": "Time Tracker: Reset All Data"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "version:from-git": "node scripts/sync-version-from-git.mjs",
    "package:vsix": "npm run version:from-git && npm run compile && npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "chartjs-chart-treemap": "^3.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.0.0"
  }
}
