{
  "name": "dev-timekeeper",
  "displayName": "Dev Timekeeper",
  "description": "Track coding time per file and directory, locally",
  "version": "1.0.15",
  "repository": {
    "type": "git",
    "url": "https://github.com/debjyoti-ghosh/time-tracker.git"
  },
  "publisher": "DebjyotiGhosh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timetracker.showDashboard",
        "title": "Time Tracker: Show Dashboard"
      },
      {
        "command": "timetracker.reset",
        "title": "Time Tracker: Reset All Data"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "chartjs-chart-treemap": "^3.1.0",
    "typescript": "^5.0.0"
  }
}
